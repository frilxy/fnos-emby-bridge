#!/bin/bash
# 配置修改后：把向导字段落到 ${TRIM_PKGVAR}/bridge.env，并重启服务使其生效。
#
# 字段名兼容：向导字段可能以原名传入，也可能带 wizard_ 前缀，两种都尝试。
# 只保留白名单键，未提供的键沿用旧值（避免改一项把其它项清空）。
set -u

VAR_DIR="${TRIM_PKGVAR}"
ENV_FILE="${VAR_DIR}/bridge.env"
mkdir -p "${VAR_DIR}" 2>/dev/null

# 间接展开 ${!name}：按变量名取值，不用 eval
pick() {
    for n in "$@"; do
        v="${!n:-}"
        if [ -n "${v}" ]; then
            printf '%s' "${v}"
            return 0
        fi
    done
    return 1
}

# 读入现有配置
declare -A CUR=()
if [ -r "${ENV_FILE}" ]; then
    while IFS= read -r line; do
        case "${line}" in ''|'#'*) continue ;; esac
        CUR["${line%%=*}"]="${line#*=}"
    done < "${ENV_FILE}"
fi

set_kv() { # key value
    [ -n "${2:-}" ] && CUR["$1"]="$2"
    return 0
}

v="$(pick fnos_base FNOS_BASE wizard_fnos_base wizard_FNOS_BASE)" && set_kv FNOS_BASE "${v}"
v="$(pick fnos_user FNOS_USER wizard_fnos_user wizard_FNOS_USER)" && set_kv FNOS_USER "${v}"
v="$(pick fnos_pass FNOS_PASS wizard_fnos_pass wizard_FNOS_PASS)" && set_kv FNOS_PASS "${v}"
v="$(pick admin_pass ADMIN_PASS wizard_admin_pass wizard_ADMIN_PASS)" && set_kv ADMIN_PASS "${v}"
v="$(pick port PORT wizard_port wizard_PORT)" && set_kv PORT "${v}"

# 原子写回
tmp="${ENV_FILE}.tmp"
: > "${tmp}"
for k in PORT ADMIN_USER ADMIN_PASS FNOS_BASE FNOS_USER FNOS_PASS HOST AUDIO_TRACK_HINT; do
    [ -n "${CUR[$k]:-}" ] && printf '%s=%s\n' "${k}" "${CUR[$k]}" >> "${tmp}"
done
mv -f "${tmp}" "${ENV_FILE}"
chmod 600 "${ENV_FILE}" 2>/dev/null

# 服务在跑则重启以加载新配置（start 自身幂等，不会起两个实例）
if [ -x "${TRIM_APPDEST}/cmd/main" ]; then
    if "${TRIM_APPDEST}/cmd/main" status >/dev/null 2>&1; then
        "${TRIM_APPDEST}/cmd/main" stop  >/dev/null 2>&1
        "${TRIM_APPDEST}/cmd/main" start >/dev/null 2>&1
    fi
fi
exit 0
