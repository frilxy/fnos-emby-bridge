+// PersonWorks 拉某演员/导演/编剧的全部关联作品。
+//
+// 按 job 逐个查询后按 guid 去重合并：同一个人可能既是演员又是导演，
+// 只查一个 job 会漏掉另一半作品。单个 job 失败不影响整体（老版本 fnOS
+// 未必有 Screenplay 等分类）。
+//
+// 先用 Actor 探一次 job 大小写（大写的空就试小写），后面按命中的那套查，
+// 避免把 5 个分类都查两遍。
+func (c *Client) PersonWorks(ctx context.Context, personGuid string) ([]MediaItem, error) {
+	seen := make(map[string]struct{}, 64)
+	out := make([]MediaItem, 0, 64)
+	add := func(list []MediaItem) int {
+		n := 0
+		for _, it := range list {
+			if it.Guid == "" {
+				continue
+			}
+			if _, dup := seen[it.Guid]; dup {
+				continue
+			}
+			seen[it.Guid] = struct{}{}
+			out = append(out, it)
+			n++
+		}
+		return n
+	}
+
+	jobs := PersonJobValues
+	// fetch 带页大小回退：部分 fnOS 版本对 page_size 有上限（影视前端默认 200），
+	// 超限直接报错——报错不能让整个 job 静默变成空列表。
+	fetch := func(job string) []MediaItem {
+		for _, size := range []int{200, 50} {
+			if list, _, err := c.PersonItemList(ctx, personGuid, job, 1, size); err == nil {
+				return list
+			}
+		}
+		return nil
+	}
+	// 真机实测（/debug/person）：job 传空串 = 不按职务过滤，一次就拿全，
+	// 且与 job=Actor 返回同样的 total。先走这条最省的路。
+	if add(fetch("")) == 0 {
+		// 少数版本空 job 无匹配：退回按职务逐个查（一个人可能既是演员又是导演）。
+		for _, job := range jobs {
+			add(fetch(job))
+		}
+	}
+	return out, nil
+}
