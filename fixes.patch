+// imageContentType 按路径扩展名兜底 Content-Type。
+func imageContentType(p string) string {
+	switch strings.ToLower(filepath.Ext(p)) {
+	case ".png":
+		return "image/png"
+	case ".webp":
+		return "image/webp"
+	case ".gif":
+		return "image/gif"
+	case ".avif":
+		return "image/avif"
+	default:
+		return "image/jpeg"
+	}
+}
