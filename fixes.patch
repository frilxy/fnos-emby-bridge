+				t.Fatalf("Actor 探测报错: %v", m["error"])
+			}
+			if n, _ := m["bytes"].(float64); n <= 0 {
+				t.Fatalf("Actor 探测没有返回数据: %v", m)
+			}
+			actorOK = true
+		}
+	}
+	if !actorOK {
+		t.Fatalf("没有 Actor/200 的探测项: %v", probes)
+	}
+}
+
+// TestPersonFilmographyVideoItems 回归「Other/AV 库演员作品为空」。
+//
+// 真机 /debug/person 证据：人物作品 total=6 全部 type=Video，而客户端按
+// IncludeItemTypes=Movie 请求；filterItemTypes 把 Video 全过滤掉 → 空列表。
+func TestPersonFilmographyVideoItems(t *testing.T) {
+	base := newPersonBridge(t)
+
+	// 电影分区：Video 条目要放行
+	movies := getJSONMap(t, base+"/Users/u/Items?PersonIds=per_002&IncludeItemTypes=Movie"+
+		"&Recursive=true&Limit=20&api_key=k")
+	if ids := itemIDs(t, movies); len(ids) != 1 || ids[0] != "fv_vid" {
+		t.Fatalf("Movie 分区=%v want [fv_vid]", ids)
+	}
+
+	// 剧集/单集分区：同一批 Video 不能重复出现在这里
+	for _, inc := range []string{"Series", "Episode"} {
+		b := getJSONMap(t, base+"/Users/u/Items?PersonIds=per_002&IncludeItemTypes="+inc+"&Recursive=true&api_key=k")
+		if ids := itemIDs(t, b); len(ids) != 0 {
+			t.Fatalf("%s 分区不该返回 Video 条目: %v", inc, ids)
+		}
+	}
+}
diff -ruN a/internal/emby/userstate.go b/internal/emby/userstate.go
--- a/internal/emby/userstate.go	1970-01-01 08:00:00.000000000 +0800
+++ b/internal/emby/userstate.go	2026-11-15 23:14:33.000000000 +0800
@@ -0,0 +1,119 @@
+package emby
+
+import (
+	"encoding/json"
+	"os"
+	"sync"
+)
+
+// userItemState 是桥接侧保存的、Emby 有而飞牛没有的用户状态：
+//   - Likes：喜欢/不喜欢（Emby 详情页的 👍/👎）
+//   - Hidden：从"继续观看"移除（不改变飞牛进度）
+//
+// 飞牛没有这两个概念，所以必须落本地；按"用户名 + 条目 guid"隔离。
+type userItemState struct {
+	Likes  *bool `json:"likes,omitempty"`
+	Hidden bool  `json:"hidden,omitempty"`
+}
+
+type userStateStore struct {
+	mu   sync.Mutex
+	path string
+	data map[string]map[string]userItemState
+}
+
+// newUserStateStore 加载本地状态文件（不存在/损坏时从空开始，不致命）。
+func newUserStateStore(path string) *userStateStore {
+	s := &userStateStore{path: path, data: map[string]map[string]userItemState{}}
+	if b, err := os.ReadFile(path); err == nil {
+		_ = json.Unmarshal(b, &s.data)
+	}
+	if s.data == nil {
+		s.data = map[string]map[string]userItemState{}
+	}
+	return s
+}
+
+func userStateKey(user string) string {
+	if user == "" {
+		return "default"
+	}
+	return user
+}
+
+// Like 返回 (是否喜欢, 是否已设置)。
+func (s *userStateStore) Like(user, guid string) (bool, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	st, ok := s.data[userStateKey(user)][guid]
+	if !ok || st.Likes == nil {
+		return false, false
+	}
+	return *st.Likes, true
+}
+
+// SetLike 保存喜欢/不喜欢状态。
+func (s *userStateStore) SetLike(user, guid string, like bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	u := userStateKey(user)
+	if s.data[u] == nil {
+		s.data[u] = map[string]userItemState{}
+	}
+	st := s.data[u][guid]
+	st.Likes = &like
+	s.data[u][guid] = st
+	s.saveLocked()
+}
+
+// ClearLike 清除喜欢/不喜欢状态（DELETE Rating）。
+func (s *userStateStore) ClearLike(user, guid string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	u := userStateKey(user)
+	st, ok := s.data[u][guid]
+	if !ok {
+		return
+	}
+	st.Likes = nil
+	if !st.Hidden {
+		delete(s.data[u], guid)
+	} else {
+		s.data[u][guid] = st
+	}
+	s.saveLocked()
+}
+
+// Hidden 判断条目是否被用户从"继续观看"隐藏。
+func (s *userStateStore) Hidden(user, guid string) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.data[userStateKey(user)][guid].Hidden
+}
+
+// SetHidden 设置/取消"从继续观看隐藏"。
+func (s *userStateStore) SetHidden(user, guid string, hidden bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	u := userStateKey(user)
+	if s.data[u] == nil {
+		s.data[u] = map[string]userItemState{}
+	}
+	st := s.data[u][guid]
+	st.Hidden = hidden
+	if !hidden && st.Likes == nil {
+		delete(s.data[u], guid)
+		s.saveLocked()
+		return
+	}
+	s.data[u][guid] = st
+	s.saveLocked()
+}
+
+func (s *userStateStore) saveLocked() {
+	b, err := json.Marshal(s.data)
+	if err != nil {
+		return
+	}
+	_ = os.WriteFile(s.path, b, 0o600)
+}
diff -ruN a/internal/emby/util.go b/internal/emby/util.go
--- a/internal/emby/util.go	2026-11-15 23:51:27.295609822 +0800
+++ b/internal/emby/util.go	2026-11-15 23:14:33.000000000 +0800
@@ -6,6 +6,7 @@
 	"io"
 	"math/rand"
 	"net/http"
+	"os"
 	"strconv"
 	"strings"
 	"sync"
@@ -120,3 +121,100 @@
 	}
 	return f
 }
+
+// ---------------------------------------------------------------------------
+// 以下为 fork 新增（上游 ssabv/fnos-emby-bridge 无这些函数）
+// ---------------------------------------------------------------------------
+
+// mimeByExt 容器扩展名 → MIME。
+// 背景：上游 /v/api/v1/media/range 一律返回 application/octet-stream，
+// 部分播放器（不依赖内容嗅探、只看 MIME 的实现）会因此拒绝播放。
+var mimeByExt = map[string]string{
+	"mp4":  "video/mp4",
+	"m4v":  "video/mp4",
+	"mkv":  "video/x-matroska",
+	"webm": "video/webm",
+	"mov":  "video/quicktime",
+	"avi":  "video/x-msvideo",
+	"ts":   "video/mp2t",
+	"m2ts": "video/mp2t",
+	"flv":  "video/x-flv",
+	"wmv":  "video/x-ms-wmv",
+	"mpg":  "video/mpeg",
+	"mpeg": "video/mpeg",
+	"m2v":  "video/mpeg",
+	"rmvb": "application/vnd.rn-realmedia-vbr",
+}
+
+// mimeForExt 按扩展名（可带点，如 ".mkv"）返回 MIME；未知返回空串。
+func mimeForExt(ext string) string {
+	return mimeByExt[strings.ToLower(strings.TrimPrefix(strings.TrimSpace(ext), "."))]
+}
+
+// genericMime 判断 Content-Type 是否属于「没有信息量」的通用类型
+// （空、application/octet-stream 等）；这类值应当用扩展名推导的 MIME 覆盖。
+func genericMime(ct string) bool {
+	ct = strings.ToLower(strings.TrimSpace(ct))
+	if i := strings.IndexByte(ct, ';'); i >= 0 {
+		ct = strings.TrimSpace(ct[:i])
+	}
+	switch ct {
+	case "", "application/octet-stream", "binary/octet-stream", "application/binary":
+		return true
+	}
+	return false
+}
+
+// parseTotalSize 从 Content-Range "bytes 0-0/6721466674" 解析资源总长度。
+// 解析失败返回 0（调用方应退化为不设置 Content-Length）。
+func parseTotalSize(contentRange string) int64 {
+	i := strings.LastIndexByte(contentRange, '/')
+	if i < 0 {
+		return 0
+	}
+	n, err := strconv.ParseInt(strings.TrimSpace(contentRange[i+1:]), 10, 64)
+	if err != nil || n <= 0 {
+		return 0
+	}
+	return n
+}
+
+// hostileAudioCodecs 移动端/电视端普遍无法直接解码的音频编码。
+// DTS/杜比（TrueHD）需要授权，多数 Android 设备不带解码器；
+// FLAC/ALAC/PCM 一般也只在桌面端或软解播放器可用。
+// 说明：这里只用于「标题提示」，不参与任何播放决策。
+var hostileAudioCodecs = map[string]bool{
+	"dts": true, "dts-hd": true, "dtshd": true, "dts-hd ma": true, "dts:x": true,
+	"truehd": true, "mlp": true, "flac": true, "alac": true,
+	"pcm": true, "pcm_s16le": true, "pcm_s24le": true, "pcm_bluray": true,
+}
+
+// audioHintEnabled 音轨兼容性提示开关（默认开启，AUDIO_TRACK_HINT=0 关闭）。
+func audioHintEnabled() bool {
+	switch strings.ToLower(strings.TrimSpace(os.Getenv("AUDIO_TRACK_HINT"))) {
+	case "0", "false", "off", "no":
+		return false
+	}
+	return true
+}
+
+// audioDisplayTitle 在音轨显示标题后追加兼容性提示，方便用户手动挑一条能直解的轨道。
+//
+// 刻意不做「自动切到兼容音轨」：备选轨常常是导演评论轨（实测霸王别姬、
+// 花样年华等文件即如此），自动切换会让用户听到错误音轨，风险高于收益。
+func audioDisplayTitle(title, codec string) string {
+	if !audioHintEnabled() {
+		return title
+	}
+	if !hostileAudioCodecs[strings.ToLower(strings.TrimSpace(codec))] {
+		return title
+	}
+	const tag = "需软解"
+	if strings.Contains(title, tag) {
+		return title
+	}
+	if title == "" {
+		return tag
+	}
+	return title + " · " + tag
+}
diff -ruN a/internal/emby/v11_features_test.go b/internal/emby/v11_features_test.go
--- a/internal/emby/v11_features_test.go	1970-01-01 08:00:00.000000000 +0800
+++ b/internal/emby/v11_features_test.go	2026-11-15 23:14:33.000000000 +0800
@@ -0,0 +1,690 @@
+package emby_test
+
+import (
+	"encoding/json"
+	"fmt"
+	"image"
+	_ "image/jpeg"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"fnos-emby-bridge/internal/emby"
+	"fnos-emby-bridge/internal/fn"
+	"fnos-emby-bridge/internal/mock"
+)
+
+// newV11Bridge 起一个 strict-auth 桥接（默认 AllowAnonymous=false），并登录一个用户。
+func newV11Bridge(t *testing.T, opts ...mock.Option) (*httptest.Server, string) {
+	t.Helper()
+	t.Chdir(t.TempDir()) // 会话/用户状态文件落临时目录
+	mock.MockReset()
+
+	fnSrv := httptest.NewServer(mock.NewHandler(false, "", opts...))
+	t.Cleanup(fnSrv.Close)
+
+	client := fn.NewClient(fnSrv.URL)
+	if err := client.Login(t.Context(), "u", fn.SHA256Hex("p")); err != nil {
+		t.Fatalf("fn login: %v", err)
+	}
+	h := emby.NewHandler(client, "fnos-test", "127.0.0.1:8096")
+	bridge := httptest.NewServer(h.Handler())
+	t.Cleanup(bridge.Close)
+	return bridge, loginToken(t, bridge.URL, "u", "p")
+}
+
+func loginToken(t *testing.T, base, user, pass string) string {
+	t.Helper()
+	resp, err := http.Post(base+"/Users/AuthenticateByName", "application/json",
+		strings.NewReader(fmt.Sprintf(`{"UserName":%q,"Pwd":%q}`, user, pass)))
+	if err != nil {
+		t.Fatalf("login %s: %v", user, err)
+	}
+	defer resp.Body.Close()
+	b, _ := io.ReadAll(resp.Body)
+	if resp.StatusCode != 200 {
+		t.Fatalf("login %s status=%d body=%s", user, resp.StatusCode, b)
+	}
+	var out struct {
+		AccessToken string `json:"AccessToken"`
+	}
+	if json.Unmarshal(b, &out) != nil || out.AccessToken == "" {
+		t.Fatalf("login %s decode: %s", user, b)
+	}
+	return out.AccessToken
+}
+
+func getWithToken(t *testing.T, url, token string) []byte {
+	t.Helper()
+	req, _ := http.NewRequest(http.MethodGet, url, nil)
+	req.Header.Set("X-Emby-Token", token)
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		t.Fatalf("GET %s: %v", url, err)
+	}
+	defer resp.Body.Close()
+	b, _ := io.ReadAll(resp.Body)
+	if resp.StatusCode != 200 {
+		t.Fatalf("GET %s status=%d body=%s", url, resp.StatusCode, b)
+	}
+	return b
+}
+
+func postWithToken(t *testing.T, method, url, token string) (int, []byte) {
+	t.Helper()
+	req, _ := http.NewRequest(method, url, nil)
+	req.Header.Set("X-Emby-Token", token)
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		t.Fatalf("%s %s: %v", method, url, err)
+	}
+	defer resp.Body.Close()
+	b, _ := io.ReadAll(resp.Body)
+	return resp.StatusCode, b
+}
+
+func decodeItems(t *testing.T, b []byte) []map[string]any {
+	t.Helper()
+	var q struct {
+		Items []map[string]any `json:"Items"`
+	}
+	if err := json.Unmarshal(b, &q); err != nil {
+		t.Fatalf("decode items: %v (%s)", err, b)
+	}
+	return q.Items
+}
+
+func idsOf(items []map[string]any) []string {
+	out := make([]string, 0, len(items))
+	for _, it := range items {
+		out = append(out, fmt.Sprint(it["Id"]))
+	}
+	return out
+}
+
+func TestSearchTermReturnsMatches(t *testing.T) {
+	bridge, token := newV11Bridge(t)
+	body := getWithToken(t, bridge.URL+"/Users/u/Items?SearchTerm=%E7%94%B5%E5%BD%B1&IncludeItemTypes=Movie", token)
+	items := decodeItems(t, body)
+	ids := idsOf(items)
+	if len(ids) == 0 || ids[0] != "fv_001" {
+		t.Fatalf("搜索『电影』应命 fv_001，实际 %v（body=%s）", ids, body)
+	}
+	for _, it := range items {
+		if fmt.Sprint(it["Id"]) == "fv_tv" {
+			t.Fatalf("搜索 Movie 时不应返回 Series：%v", ids)
+		}
+	}
+}
+
+func TestDateCreatedUsesCreateTimeNotPremiere(t *testing.T) {
+	bridge, token := newV11Bridge(t, mock.WithTVLibrary())
+	// fv_001：入库晚、首播早；fv_tv2：入库早、首播晚。
+	mock.SetItemField("fv_001", "create_time", 1800000000)
+	mock.SetItemField("fv_001", "air_date", "2000-01-01")
+	mock.SetItemField("fv_tv2", "create_time", 1600000000)
+	mock.SetItemField("fv_tv2", "air_date", "2024-01-01")
+
+	body := getWithToken(t, bridge.URL+"/Items?IncludeItemTypes=Movie,Series&SortBy=DateCreated&SortOrder=Descending", token)
+	ids := idsOf(decodeItems(t, body))
+	if len(ids) < 2 || ids[0] != "fv_001" {
+		t.Fatalf("按 DateCreated 降序应先 fv_001（入库晚），实际 %v", ids)
+	}
+
+	body = getWithToken(t, bridge.URL+"/Items?IncludeItemTypes=Movie,Series&SortBy=PremiereDate&SortOrder=Descending", token)
+	ids = idsOf(decodeItems(t, body))
+	if len(ids) < 2 || ids[0] != "fv_tv2" {
+		t.Fatalf("按 PremiereDate 降序应先 fv_tv2（首播晚），实际 %v", ids)
+	}
+
+	// 详情里的 DateCreated 应来自 create_time
+	body = getWithToken(t, bridge.URL+"/Items/fv_001", token)
+	var it map[string]any
+	_ = json.Unmarshal(body, &it)
+	dc, _ := it["DateCreated"].(string)
+	if !strings.HasPrefix(dc, "2027") { // 1800000000 ≈ 2027-01
+		t.Fatalf("DateCreated 未使用 create_time：%q", dc)
+	}
+
+	// 元数据：原始标题 / 分级 / 国家 / TMDB ProviderId
+	body = getWithToken(t, bridge.URL+"/Items/fv_tv2", token)
+	_ = json.Unmarshal(body, &it)
+	if fmt.Sprint(it["OriginalTitle"]) != "Drama C" || fmt.Sprint(it["OfficialRating"]) != "TV-14" {
+		t.Fatalf("原始标题/分级未映射：OriginalTitle=%v OfficialRating=%v", it["OriginalTitle"], it["OfficialRating"])
+	}
+	props, _ := it["ProductionLocations"].([]any)
+	if len(props) == 0 || fmt.Sprint(props[0]) != "CN" {
+		t.Fatalf("国家未映射：%v", it["ProductionLocations"])
+	}
+	pid, _ := it["ProviderIds"].(map[string]any)
+	if fmt.Sprint(pid["Tmdb"]) != "12345" {
+		t.Fatalf("TMDB ProviderId 未映射：%v", pid)
+	}
+}
+
+func TestMultiKeySortAndRandomPaging(t *testing.T) {
+	bridge, token := newV11Bridge(t, mock.WithTVLibrary())
+	// ProductionYear 是主键：fv_tv2=2020，fv_001=2000
+	mock.SetItemField("fv_001", "air_date", "2000-01-01")
+	body := getWithToken(t, bridge.URL+"/Items?IncludeItemTypes=Movie,Series&SortBy=ProductionYear,PremiereDate&SortOrder=Descending", token)
+	ids := idsOf(decodeItems(t, body))
+	if len(ids) == 0 || ids[0] != "fv_tv2" {
+		t.Fatalf("多键排序应先按 ProductionYear 倒序（fv_tv2=2020）：%v", ids)
+	}
+
+	// Random 分页：两页合起来应覆盖全部且不重复
+	page1 := getWithToken(t, bridge.URL+"/Items?IncludeItemTypes=Movie,Series&SortBy=Random&Limit=2&StartIndex=0", token)
+	page2 := getWithToken(t, bridge.URL+"/Items?IncludeItemTypes=Movie,Series&SortBy=Random&Limit=2&StartIndex=2", token)
+	all := append(idsOf(decodeItems(t, page1)), idsOf(decodeItems(t, page2))...)
+	seen := map[string]bool{}
+	for _, id := range all {
+		if seen[id] {
+			t.Fatalf("Random 分页出现重复条目：%v（p1=%v p2=%v）", all, idsOf(decodeItems(t, page1)), idsOf(decodeItems(t, page2)))
+		}
+		seen[id] = true
+	}
+	if len(all) < 3 {
+		t.Fatalf("Random 分页条目不足：%v", all)
+	}
+}
+
+func TestIs4KAndYearFilters(t *testing.T) {
+	bridge, token := newV11Bridge(t, mock.WithTVLibrary())
+	body := getWithToken(t, bridge.URL+"/Items?Is4K=true&Recursive=true&IncludeItemTypes=Episode", token)
+	ids := idsOf(decodeItems(t, body))
+	if len(ids) != 1 || ids[0] != "fv_ep2" {
+		t.Fatalf("Is4K 应只返回 4K 的 fv_ep2：%v（%s）", ids, body)
+	}
+	body = getWithToken(t, bridge.URL+"/Items?Years=2020&IncludeItemTypes=Movie,Series", token)
+	ids = idsOf(decodeItems(t, body))
+	found := false
+	for _, id := range ids {
+		if id == "fv_tv2" {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatalf("Years=2020 应包含 fv_tv2：%v", ids)
+	}
+}
+
+func TestGenresFiltersAndDictionary(t *testing.T) {
+	bridge, token := newV11Bridge(t, mock.WithTVLibrary())
+	mock.SetItemField("fv_001", "genres", []int{2})
+
+	body := getWithToken(t, bridge.URL+"/Genres", token)
+	var g struct {
+		Items []map[string]any `json:"Items"`
+	}
+	if err := json.Unmarshal(body, &g); err != nil || len(g.Items) == 0 {
+		t.Fatalf("/Genres 应返回类型字典：%s", body)
+	}
+
+	body = getWithToken(t, bridge.URL+"/Items?Genres=%E5%89%A7%E6%83%85&IncludeItemTypes=Movie,Series", token)
+	ids := idsOf(decodeItems(t, body))
+	found := false
+	for _, id := range ids {
+		if id == "fv_tv2" {
+			found = true
+		}
+		if id == "fv_001" {
+			t.Fatalf("genres=剧情 不应包含 genres=科幻 的 fv_001：%v", ids)
+		}
+	}
+	if !found {
+		t.Fatalf("genres=剧情 应包含 fv_tv2：%v", ids)
+	}
+
+	// Yamby 常用 GenreIds（id）而不是 Genres（名称）
+	body = getWithToken(t, bridge.URL+"/Items?GenreIds=1&IncludeItemTypes=Movie,Series", token)
+	ids = idsOf(decodeItems(t, body))
+	if len(ids) == 0 {
+		t.Fatalf("GenreIds=1 应返回剧情条目：%s", body)
+	}
+
+	// 年份按飞牛习惯合并为年代；Yamby 不应同时出现 2020 和 2020s。
+	body = getWithToken(t, bridge.URL+"/Years?ParentId=lib_tv", token)
+	var yres struct {
+		Items []map[string]any `json:"Items"`
+	}
+	if err := json.Unmarshal(body, &yres); err != nil {
+		t.Fatalf("/Years decode: %s", body)
