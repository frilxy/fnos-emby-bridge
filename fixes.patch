+// itemSortDate 取条目用于排序的日期（首播 → 发行 → 首映，取第一个能解析的）。
+func itemSortDate(m fn.MediaItem) time.Time {
+	for _, s := range []string{m.AirDate, m.ReleaseDate, m.FirstAirDate} {
+		if s == "" {
+			continue
+		}
+		for _, layout := range []string{
+			"2006-01-02",
+			"2006-01-02T15:04:05Z07:00",
+			"2006-01-02 15:04:05",
+		} {
