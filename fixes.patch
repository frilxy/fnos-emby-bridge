+func (h *Handler) streamHead(w http.ResponseWriter, r *http.Request, mediaGuid, mimeHint, clientRange string) {
+	hdr, _, body, err := h.fnOf(r.Context()).RangeMedia(r.Context(), mediaGuid, "bytes=0-0")
