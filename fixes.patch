+// imageTagFor 返回图片 tag：用图片路径的短哈希做缓存键。
+// 这样海报/背景图变化时客户端 URL 会变，不会一直命中旧的 1×1/占位图缓存。
+func imageTagFor(p string) string {
+	if p == "" {
+		return ""
+	}
+	h := fnv.New64a()
+	_, _ = h.Write([]byte(p))
+	return fmt.Sprintf("h%x", h.Sum64())
+}
