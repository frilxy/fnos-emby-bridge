--- a/internal/emby/cache.go	1970-01-01 08:00:00.000000000 +0800
+++ b/internal/emby/cache.go	2026-11-15 23:14:33.000000000 +0800
@@ -0,0 +1,86 @@
+package emby
+
+import (
+	"strings"
+	"sync"
+	"time"
+)
+
+// ttlCache 是带"同 key 请求合并（singleflight）"的轻量缓存。
+// 用于媒体库列表、详情、play/info、stream/list、tag 字典等重复度高的读请求。
+// 注意：缓存值必须视为不可变；调用方拿到切片后要复制再排序/过滤。
+type ttlCache struct {
+	mu    sync.Mutex
+	items map[string]cacheItem
+	calls map[string]*cacheCall
+}
+
+type cacheItem struct {
+	val     any
+	expires time.Time
+}
+
+type cacheCall struct {
+	done chan struct{}
+	val  any
+	err  error
+}
+
+func newTTLCache() *ttlCache {
+	return &ttlCache{items: map[string]cacheItem{}, calls: map[string]*cacheCall{}}
+}
+
+// Do 命中未过期缓存直接返回；同 key 并发只执行一次 fn。
+func (c *ttlCache) Do(key string, ttl time.Duration, fn func() (any, error)) (any, error) {
+	c.mu.Lock()
+	if it, ok := c.items[key]; ok && time.Now().Before(it.expires) {
+		v := it.val
+		c.mu.Unlock()
+		return v, nil
+	}
+	if call, ok := c.calls[key]; ok {
+		c.mu.Unlock()
+		<-call.done
+		return call.val, call.err
+	}
+	call := &cacheCall{done: make(chan struct{})}
+	c.calls[key] = call
+	c.mu.Unlock()
+
+	v, err := fn()
+
+	c.mu.Lock()
+	if err == nil {
+		c.items[key] = cacheItem{val: v, expires: time.Now().Add(ttl)}
+	}
+	call.val, call.err = v, err
+	delete(c.calls, key)
+	close(call.done)
+	c.mu.Unlock()
+	return v, err
+}
+
+// Delete 删除单个 key（写操作后失效用）。
+func (c *ttlCache) Delete(key string) {
+	c.mu.Lock()
+	delete(c.items, key)
+	c.mu.Unlock()
+}
+
+// DeletePrefix 删除指定前缀的 key（写操作后清理某用户/某条目的列表缓存）。
+func (c *ttlCache) DeletePrefix(prefix string) {
+	c.mu.Lock()
+	for k := range c.items {
+		if strings.HasPrefix(k, prefix) {
+			delete(c.items, k)
+		}
+	}
+	c.mu.Unlock()
+}
+
+// Clear 清空全部缓存（库扫描/刷新后可用）。
+func (c *ttlCache) Clear() {
+	c.mu.Lock()
+	c.items = map[string]cacheItem{}
+	c.mu.Unlock()
+}
diff -ruN a/internal/emby/cache_test.go b/internal/emby/cache_test.go
--- a/internal/emby/cache_test.go	1970-01-01 08:00:00.000000000 +0800
+++ b/internal/emby/cache_test.go	2026-11-15 23:14:33.000000000 +0800
@@ -0,0 +1,40 @@
+package emby
+
+import (
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// 同 key 并发只执行一次 fn（singleflight），之后的请求命中缓存。
+func TestTTLCacheSingleflight(t *testing.T) {
+	c := newTTLCache()
+	var calls int32
+	var wg sync.WaitGroup
+	for i := 0; i < 20; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			v, err := c.Do("k", time.Minute, func() (any, error) {
+				atomic.AddInt32(&calls, 1)
+				time.Sleep(20 * time.Millisecond)
+				return "v", nil
+			})
+			if err != nil || v != "v" {
+				t.Errorf("Do = %v, %v", v, err)
+			}
+		}()
+	}
+	wg.Wait()
+	if calls != 1 {
+		t.Fatalf("并发 20 次应只执行 1 次 fn，实际 %d", calls)
+	}
+	if _, _ = c.Do("k", time.Minute, func() (any, error) {
+		atomic.AddInt32(&calls, 1)
+		return "v", nil
+	}); calls != 1 {
+		t.Fatalf("缓存命中不应再执行 fn，实际 %d", calls)
+	}
+	c.Delete("k")
+}
