+package emby
+
+// 影视库封面：飞牛原生会把库内 3 张海报拼成一张库封面。
+// 这里在桥接侧复刻：从库里稳定随机挑 3 个有 poster 的条目，取飞牛 sys/img，
+// 按竖版三栏拼接成 600x900 JPEG；按 30 分钟桶缓存，ImageTags.Primary 同步换 tag，
+// 客户端会重新拉取。
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"hash/fnv"
+	"image"
+	"image/color"
+	"image/jpeg"
+	"image/png"
+	"io"
+	"log"
+	"math/rand"
+	"net/http"
+	"strings"
+	"time"
+
+	xdraw "golang.org/x/image/draw"
+	_ "golang.org/x/image/webp"
+
