+// genreNames 返回 genre id → 名称（10 分钟缓存）。
+func (h *Handler) genreNames(ctx context.Context, client *fn.Client) map[int]string {
+	h.genreMu.Lock()
+	defer h.genreMu.Unlock()
+	if h.genreMap != nil && time.Since(h.genreAt) < 10*time.Minute {
+		return h.genreMap
+	}
+	genres, err := client.TagGenres(ctx, "zh-CN")
+	if (err != nil || len(genres) == 0) && h.FN != nil && h.FN != client {
+		// 普通用户 token 可能没有 tag/genres 权限；类型字典是公共元数据，用 admin 再试。
+		if g2, e2 := h.FN.TagGenres(ctx, "zh-CN"); e2 == nil && len(g2) > 0 {
+			genres, err = g2, nil
+			log.Printf("[genres] 用户 token 取类型失败，已用 admin token 兜底")
+		}
+	}
+	if err != nil {
+		if h.genreMap != nil {
+			return h.genreMap
+		}
+		return map[int]string{}
+	}
+	m := make(map[int]string, len(genres))
+	for _, g := range genres {
+		if g.ID > 0 && g.Value != "" {
+			m[g.ID] = g.Value
+		}
+	}
+	h.genreMap = m
+	h.genreAt = time.Now()
+	return m
+}
