+			maxW = parseInt(parts[3])
+		}
+		if len(parts) > 4 {
+			maxH = parseInt(parts[4])
+		}
+	}
+	q := r.URL.Query()
+	if v := queryGet(q, "tag"); v != "" {
+		tag = v
+	}
+	if v := queryGet(q, "maxWidth"); v != "" {
+		maxW = parseInt(v)
+	}
+	if v := queryGet(q, "maxHeight"); v != "" {
+		maxH = parseInt(v)
+	}
+	_ = format
+	return
+}
