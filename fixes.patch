+// flexStrs 兼容 string / []string，并保留全部值（背景图/海报可能有多个）。
+type flexStrs []string
+
+func (f *flexStrs) UnmarshalJSON(b []byte) error {
+	if len(b) == 0 || string(b) == "null" {
+		*f = nil
+		return nil
+	}
+	if b[0] == '[' {
+		var arr []string
+		if err := json.Unmarshal(b, &arr); err != nil {
+			*f = nil
+			return nil // 形态不符时忽略
+		}
+		out := make([]string, 0, len(arr))
+		for _, s := range arr {
+			if s = strings.TrimSpace(s); s != "" {
+				out = append(out, s)
+			}
+		}
+		*f = out
+		return nil
+	}
+	var s string
+	if err := json.Unmarshal(b, &s); err != nil {
+		*f = nil
+		return nil
+	}
+	s = strings.TrimSpace(s)
+	if s == "" {
+		*f = nil
+		return nil
+	}
+	var out []string
+	for _, part := range strings.Split(s, "\n") {
+		if part = strings.TrimSpace(part); part != "" {
+			out = append(out, part)
+		}
+	}
+	*f = out
+	return nil
+}
+
+// First 返回第一个非空值（无值返回空串）。
+func (f flexStrs) First() string {
+	for _, s := range f {
+		if s != "" {
+			return s
+		}
+	}
+	return ""
+}
+
+// flexInt 兼容 number / numeric string（id、集数等）。
+type flexInt int
+
+func (f *flexInt) UnmarshalJSON(b []byte) error {
+	if len(b) == 0 || string(b) == "null" {
+		*f = 0
+		return nil
+	}
+	s := strings.Trim(string(b), `"`)
+	if s == "" {
+		*f = 0
+		return nil
+	}
+	var n int
+	if _, err := fmt.Sscanf(s, "%d", &n); err != nil {
+		*f = 0
+		return nil
+	}
+	*f = flexInt(n)
+	return nil
+}
+
+// flexInts 兼容数字数组 / 字符串数组 / 单值（genres 在不同版本形态不同）。
+type flexInts []int
+
+func (f *flexInts) UnmarshalJSON(b []byte) error {
+	if len(b) == 0 || string(b) == "null" {
+		*f = nil
+		return nil
+	}
+	if b[0] == '[' {
+		var raw []json.RawMessage
+		if err := json.Unmarshal(b, &raw); err != nil {
+			return err
+		}
+		out := make([]int, 0, len(raw))
+		for _, r := range raw {
+			var n int
+			if _, err := fmt.Sscanf(strings.Trim(string(r), `"`), "%d", &n); err == nil && n > 0 {
+				out = append(out, n)
+			}
+		}
+		*f = out
+		return nil
+	}
+	var n int
+	if _, err := fmt.Sscanf(strings.Trim(string(b), `"`), "%d", &n); err == nil && n > 0 {
+		*f = []int{n}
+		return nil
+	}
+	*f = nil
+	return nil
+}
+
+// flexTime 把飞牛的入库时间（秒 / 毫秒 / 日期串）统一成 unix 秒。
+type flexTime int64
+
+func (f *flexTime) UnmarshalJSON(b []byte) error {
+	if len(b) == 0 || string(b) == "null" {
+		*f = 0
+		return nil
+	}
+	s := strings.TrimSpace(string(b))
+	if s == "" {
+		*f = 0
+		return nil
+	}
+	if s[0] == '"' {
+		var str string
+		if err := json.Unmarshal(b, &str); err != nil {
+			return err
+		}
+		str = strings.TrimSpace(str)
+		if str == "" {
+			*f = 0
+			return nil
+		}
+		var n int64
+		if _, err := fmt.Sscanf(str, "%d", &n); err == nil {
+			*f = flexTime(normalizeEpoch(n))
+			return nil
+		}
+		for _, layout := range []string{
+			"2006-01-02 15:04:05", "2006-01-02T15:04:05Z07:00",
+			"2006-01-02T15:04:05", "2006-01-02", time.RFC3339,
+		} {
+			if t, err := time.Parse(layout, str); err == nil {
+				*f = flexTime(t.Unix())
+				return nil
+			}
+		}
+		*f = 0
+		return nil
+	}
+	var n int64
+	if _, err := fmt.Sscanf(s, "%d", &n); err != nil {
+		*f = 0
+		return nil
+	}
+	*f = flexTime(normalizeEpoch(n))
+	return nil
+}
+
+// normalizeEpoch 判断时间戳单位：>1e12 视为毫秒，>1e8 视为秒，其余视为无效。
+func normalizeEpoch(n int64) int64 {
+	switch {
+	case n > 1_000_000_000_000:
+		return n / 1000
+	case n > 100_000_000:
+		return n
+	default:
+		return 0
+	}
+}
